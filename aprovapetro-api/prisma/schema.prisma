generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  indexAprovaPetro Int      @default(0)
  xp               Int      @default(0)
  streak           Int      @default(0)
  cargoId          String?
  sessionId        String?
  avatarId         String?  @default("avatar-1")
  examDate         DateTime?
  createdAt        DateTime @default(now())


  
  cargo            Cargo?   @relation(fields: [cargoId], references: [id])
  answers          UserAnswer[]
  missions         DailyMission[]
  simuladoAttempts SimuladoAttempt[]

  @@index([xp(sort: Desc)])
}

model Cargo {
  id          String @id @default(uuid())
  name        String
  description String?
  level       String @default("TÉCNICO")
  
  users       User[]
  simulados   Simulado[]
}

model DailyMission {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @default(now())
  title     String
  tasks     String   // JSON stringified list of tasks
  isDone    Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id])
}

model Subject {
  id     String  @id @default(uuid())
  name   String
  color  String?
  topics Topic[]
}

model Topic {
  id        String  @id @default(uuid())
  subjectId String
  name      String
  
  subject   Subject @relation(fields: [subjectId], references: [id])
  questions Question[]
}

model Question {
  id            String  @id @default(uuid())
  topicId       String
  bank          String?
  year          Int?
  statement     String
  correctOption Int
  explanation   String?
  tip           String? // Macete da PETRA IA

  topic         Topic   @relation(fields: [topicId], references: [id])
  options       Option[]
  answers       UserAnswer[]
  simulados     SimuladoQuestion[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String
  orderIndex Int

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Simulado {
  id          String   @id @default(uuid())
  title       String
  description String?
  durationMin Int      @default(240) // 4 hours
  cargoId     String
  
  cargo       Cargo    @relation(fields: [cargoId], references: [id])
  questions   SimuladoQuestion[]
  attempts    SimuladoAttempt[]
}

model SimuladoQuestion {
  id         String   @id @default(uuid())
  simuladoId String
  questionId String
  orderIndex Int
  
  simulado   Simulado @relation(fields: [simuladoId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
}

model SimuladoAttempt {
  id         String   @id @default(uuid())
  userId     String
  simuladoId String
  score      Int?     // percentage or raw score
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  
  user       User     @relation(fields: [userId], references: [id])
  simulado   Simulado @relation(fields: [simuladoId], references: [id])
}

model UserAnswer {
  id              String   @id @default(uuid())
  userId          String
  questionId      String
  isCorrect       Boolean
  timeSpentMs     Int?
  answeredAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  question        Question @relation(fields: [questionId], references: [id])
  
  @@index([userId])
  @@index([userId, isCorrect])
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Exam {
  id           String   @id @default(uuid())
  title        String
  banca        String
  orgao        String
  year         Int
  pdfUrl       String?
  gabaritoUrl  String?
  isPremium    Boolean  @default(false)
  createdAt    DateTime @default(now())
}
